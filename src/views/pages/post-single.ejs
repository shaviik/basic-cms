<%- include('../partials/header') %>

<article class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
  
  <!-- متادیتای پست -->
  <div class="mb-8 pb-6 border-b border-gray-200">
    <div class="flex items-center gap-2 mb-4">
      <% if (post.post_type) { %>
        <span class="px-3 py-1 bg-indigo-100 text-indigo-700 rounded-full text-xs font-bold">
          <%= post.post_type %>
        </span>
      <% } %>
      <% if (post.category) { %>
        <span class="px-3 py-1 bg-gray-100 text-gray-700 rounded-full text-xs font-medium">
          <%= post.category %>
        </span>
      <% } %>
      <span class="text-xs text-gray-400 font-mono">
        <%= post.created_at %>
      </span>
    </div>

    <h1 class="text-3xl md:text-5xl font-extrabold text-gray-900 tracking-tight mb-4 leading-tight">
      <%= post.title %>
    </h1>

    <div class="flex items-center gap-3 text-sm text-gray-600">
      <span>نویسنده: <strong class="text-gray-900"><%= post.author_name || 'مدیریت سایت' %></strong></span>
    </div>
  </div>

  <% if (post.excerpt) { %>
    <div class="bg-indigo-50/50 border-r-4 border-indigo-500 p-4 rounded-xl text-gray-700 text-base leading-relaxed mb-8">
      <%= post.excerpt %>
    </div>
  <% } %>

  <!-- بخش اصلی رندر و اجرای مستقیم کدهای HTML بدون فرار داده شدن (Unescaped) -->
  <div class="post-content bg-white p-6 md:p-8 rounded-2xl border border-gray-200 shadow-sm leading-relaxed text-gray-800">
    <%- post.content_html %>
  </div>

  <div class="mt-12 pt-6 border-t border-gray-200 flex justify-between items-center">
    <a href="/posts" class="text-indigo-600 hover:text-indigo-800 font-medium text-sm">
      ← بازگشت به تمام مطالب
    </a>
    <a href="/admin/posts/edit/<%= post.id %>" class="text-xs bg-gray-100 hover:bg-gray-200 text-gray-700 px-3 py-1.5 rounded-lg transition">
      ویرایش این مطلب در پنل ادمین
    </a>
  </div>

</article>

<%- include('../partials/footer') %>
