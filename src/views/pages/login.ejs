<%- include('../partials/header') %>

<div class="max-w-md mx-auto px-4 py-16">
  <div class="bg-white p-8 rounded-2xl shadow-sm border border-gray-200">
    <div class="text-center mb-8">
      <h1 class="text-2xl font-bold text-gray-900 mb-2">ورود به پنل مدیریت CMS</h1>
      <p class="text-sm text-gray-500">برای ورود، از حساب کاربری مدیر یا پیش‌فرض استفاده کنید</p>
    </div>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="mb-6 p-4 bg-red-50 border-r-4 border-red-500 text-red-700 text-sm rounded-lg flex items-center justify-between">
        <span><%= error === 'unauthorized' ? 'برای دسترسی ابتدا باید وارد شوید.' : (error === 'expired' ? 'نشست شما منقضی شده، مجدداً وارد شوید.' : error) %></span>
      </div>
    <% } %>

    <% if (typeof success !== 'undefined' && success) { %>
      <div class="mb-6 p-4 bg-green-50 border-r-4 border-green-500 text-green-700 text-sm rounded-lg">
        <%= success === 'logged_out' ? 'با موفقیت از سیستم خارج شدید.' : success %>
      </div>
    <% } %>

    <form action="/auth/login" method="POST" class="space-y-5">
      <div>
        <label for="email" class="block text-sm font-medium text-gray-700 mb-1">آدرس ایمیل</label>
        <input 
          type="email" 
          id="email" 
          name="email" 
          value="admin@cms.local" 
          required 
          class="w-full px-4 py-2.5 rounded-xl border border-gray-300 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition text-left dir-ltr"
          placeholder="admin@cms.local"
        >
      </div>

      <div>
        <label for="password" class="block text-sm font-medium text-gray-700 mb-1">کلمه عبور</label>
        <input 
          type="password" 
          id="password" 
          name="password" 
          value="admin123" 
          required 
          class="w-full px-4 py-2.5 rounded-xl border border-gray-300 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition text-left dir-ltr"
          placeholder="••••••••"
        >
      </div>

      <div class="p-3 bg-indigo-50 rounded-xl text-xs text-indigo-700 border border-indigo-100 leading-relaxed">
        💡 <strong>اطلاعات حساب سوپر ادمین پیش‌فرض:</strong><br>
        ایمیل: <code>admin@cms.local</code> | رمز: <code>admin123</code>
      </div>

      <button 
        type="submit" 
        class="w-full py-3 px-4 bg-indigo-600 hover:bg-indigo-700 text-white font-medium rounded-xl shadow-md shadow-indigo-100 transition duration-150"
      >
        ورود امن به سیستم (با کوکی HttpOnly)
      </button>
    </form>
  </div>
</div>

<%- include('../partials/footer') %>
