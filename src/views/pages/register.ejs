<%- include('../partials/header') %>

<div class="max-w-md mx-auto px-4 py-16">
  <div class="bg-white p-8 rounded-2xl shadow-sm border border-gray-200">
    <div class="text-center mb-8">
      <h1 class="text-2xl font-bold text-gray-900 mb-2">ایجاد حساب کاربری جدید</h1>
      <p class="text-sm text-gray-500">مشخصات خود را برای ثبت‌نام در سامانه وارد کنید</p>
    </div>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="mb-6 p-4 bg-red-50 border-r-4 border-red-500 text-red-700 text-sm rounded-lg">
        <%= error %>
      </div>
    <% } %>

    <form action="/auth/register" method="POST" class="space-y-5">
      <div>
        <label for="full_name" class="block text-sm font-medium text-gray-700 mb-1">نام و نام خانوادگی</label>
        <input 
          type="text" 
          id="full_name" 
          name="full_name" 
          required 
          class="w-full px-4 py-2.5 rounded-xl border border-gray-300 focus:ring-2 focus:ring-indigo-500 outline-none transition text-sm"
          placeholder="مثال: رضا احمدی"
        >
      </div>

      <div>
        <label for="email" class="block text-sm font-medium text-gray-700 mb-1">آدرس ایمیل</label>
        <input 
          type="email" 
          id="email" 
          name="email" 
          required 
          class="w-full px-4 py-2.5 rounded-xl border border-gray-300 focus:ring-2 focus:ring-indigo-500 outline-none transition text-left dir-ltr text-sm"
          placeholder="reza@example.com"
        >
      </div>

      <div>
        <label for="password" class="block text-sm font-medium text-gray-700 mb-1">کلمه عبور</label>
        <input 
          type="password" 
          id="password" 
          name="password" 
          required 
          class="w-full px-4 py-2.5 rounded-xl border border-gray-300 focus:ring-2 focus:ring-indigo-500 outline-none transition text-left dir-ltr text-sm"
          placeholder="••••••••"
        >
      </div>

      <button 
        type="submit" 
        class="w-full py-3 px-4 bg-indigo-600 hover:bg-indigo-700 text-white font-medium rounded-xl shadow-md shadow-indigo-100 transition duration-150"
      >
        ثبت نام در سایت
      </button>

      <div class="text-center pt-2">
        <a href="/auth/login" class="text-xs text-indigo-600 hover:underline">قبلاً ثبت‌نام کرده‌اید؟ ورود به حساب</a>
      </div>
    </form>
  </div>
</div>

<%- include('../partials/footer') %>
