<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'سیستم مدیریت محتوا (CMS)' %></title>
  <!-- فونت و استایل‌های پایه برای زیبایی و ظاهر مدرن -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/vazirmatn@33.0.3/Vazirmatn-font-face.css">
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['Vazirmatn', 'sans-serif'],
          }
        }
      }
    }
  </script>
  <link rel="stylesheet" href="/css/custom.css">
</head>
<body class="bg-gray-50 text-gray-800 font-sans min-h-screen flex flex-col">

<!-- هدر و نوار ناوبری اصلی (یک بار تعریف شده و در همه صفحات قابل استفاده است) -->
<header class="bg-white border-b border-gray-200 sticky top-0 z-50 shadow-sm">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-16">
      
      <!-- لوگو و عنوان سایت -->
      <div class="flex items-center space-x-reverse space-x-4">
        <a href="/" class="flex items-center gap-2">
          <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-indigo-600 to-purple-600 flex items-center justify-center text-white font-bold text-xl shadow-md">
            C
          </div>
          <span class="font-bold text-xl text-gray-900 tracking-tight">سیستم CMS مدرن</span>
        </a>

        <!-- منوی صفحات عمومی -->
        <nav class="hidden md:flex space-x-reverse space-x-6 mr-8">
          <a href="/" class="text-gray-600 hover:text-indigo-600 font-medium transition-colors">صفحه اصلی</a>
          <a href="/posts" class="text-gray-600 hover:text-indigo-600 font-medium transition-colors">مطالب و مقالات</a>
          <a href="/about" class="text-gray-600 hover:text-indigo-600 font-medium transition-colors">درباره ما</a>
        </nav>
      </div>

      <!-- وضعیت کاربری و دسترسی به پنل مدیریت -->
      <div class="flex items-center gap-3">
        <% if (typeof currentUser !== 'undefined' && currentUser) { %>
          <div class="flex items-center gap-3">
            <span class="text-sm text-gray-600 hidden sm:inline">
              خوش آمدید، <strong class="text-gray-900"><%= currentUser.fullName || currentUser.email %></strong>
              <span class="bg-indigo-100 text-indigo-700 text-xs px-2 py-0.5 rounded-full font-semibold"><%= currentUser.role %></span>
            </span>

            <% if (currentUser.role === 'SUPER_ADMIN' || currentUser.role === 'ADMIN') { %>
              <a href="/admin/dashboard" class="bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-medium px-4 py-2 rounded-lg transition shadow-sm">
                پنل مدیریت CMS
              </a>
            <% } %>

            <a href="/auth/logout" class="text-red-500 hover:text-red-700 text-sm font-medium px-3 py-2 rounded-lg border border-red-200 hover:bg-red-50 transition">
              خروج
            </a>
          </div>
        <% } else { %>
          <div class="flex items-center gap-2">
            <a href="/auth/login" class="text-gray-700 hover:text-indigo-600 text-sm font-medium px-4 py-2 rounded-lg transition">ورود</a>
            <a href="/auth/register" class="bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-medium px-4 py-2 rounded-lg transition shadow-sm">ثبت‌نام</a>
          </div>
        <% } %>
      </div>

    </div>
  </div>
</header>

<main class="flex-grow">
