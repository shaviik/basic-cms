<%- include('../partials/header') %>

<div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
  
  <div class="flex items-center justify-between mb-8 pb-6 border-b border-gray-200">
    <div>
      <div class="flex items-center gap-2 mb-1">
        <a href="/admin/dashboard" class="text-xs text-indigo-600 hover:underline">← بازگشت به داشبورد</a>
      </div>
      <h1 class="text-2xl md:text-3xl font-extrabold text-gray-900">کتابخانه و مدیریت متمرکز رسانه‌ها</h1>
      <p class="text-sm text-gray-500 mt-1">
        آپلود فایل‌ها با پکیج Multer، ذخیره متادیتا در دیتابیس SQLite و کپی سریع آدرس جهت درج در کدهای HTML.
      </p>
    </div>
  </div>

  <% if (typeof success !== 'undefined' && success) { %>
    <div class="mb-6 p-4 bg-green-50 border-r-4 border-green-500 text-green-700 text-sm rounded-xl">
      <%= success %>
    </div>
  <% } %>

  <% if (typeof error !== 'undefined' && error) { %>
    <div class="mb-6 p-4 bg-red-50 border-r-4 border-red-500 text-red-700 text-sm rounded-xl">
      <%= error %>
    </div>
  <% } %>

  <!-- فرم واقعی آپلود فایل با Multer و multipart/form-data -->
  <form action="/admin/media/upload" method="POST" enctype="multipart/form-data" class="bg-white p-8 rounded-2xl border-2 border-dashed border-gray-300 hover:border-indigo-500 transition text-center mb-10 shadow-sm">
    <div class="w-16 h-16 bg-indigo-50 text-indigo-600 rounded-2xl flex items-center justify-center mx-auto mb-4 text-2xl">
      📤
    </div>
    <h3 class="text-base font-bold text-gray-900 mb-1">آپلود رسانه جدید در دیتابیس و سرور</h3>
    <p class="text-xs text-gray-500 mb-4">فرمت‌های مجاز: PNG, JPG, WEBP, SVG, PDF, MP4 (حداکثر ۱۰ مگابایت)</p>
    
    <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
      <input 
        type="file" 
        name="file" 
        required
        class="text-xs text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-xl file:border-0 file:text-xs file:font-semibold file:bg-indigo-50 file:text-indigo-700 hover:file:bg-indigo-100"
      >
      <button type="submit" class="bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-bold px-5 py-2.5 rounded-xl shadow-md transition">
        شروع آپلود به سرور
      </button>
    </div>
  </form>

  <!-- گالری رسانه‌های ذخیره شده در پایگاه داده -->
  <div class="bg-white p-6 rounded-2xl border border-gray-200 shadow-sm">
    <div class="flex items-center justify-between mb-6 pb-3 border-b border-gray-100">
      <h2 class="text-base font-bold text-gray-900">فایل‌های ثبت شده در سیستم</h2>
      <span class="text-xs text-gray-500"><%= mediaFiles.length %> فایل در دیتابیس</span>
    </div>

    <% if (mediaFiles.length === 0) { %>
      <div class="p-12 text-center text-gray-400 text-sm">
        هنوز هیچ فایلی آپلود نشده است. با استفاده از فرم بالا اولین تصویر یا فایل را آپلود کنید.
      </div>
    <% } else { %>
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
        <% mediaFiles.forEach(file => { %>
          <div class="border border-gray-200 rounded-xl overflow-hidden hover:shadow-md transition flex flex-col group">
            
            <div class="h-36 bg-gray-100 flex items-center justify-center overflow-hidden relative">
              <% if (file.mime_type.startsWith('image/')) { %>
                <img src="<%= file.url %>" alt="<%= file.original_name %>" class="w-full h-full object-cover">
              <% } else { %>
                <span class="text-4xl">📄</span>
              <% } %>
              <span class="absolute top-2 left-2 bg-black/70 text-white text-[10px] px-2 py-0.5 rounded-md font-mono">
                <%= (file.size / 1024).toFixed(1) %> KB
              </span>
            </div>

            <div class="p-3 flex flex-col flex-grow">
              <div class="font-bold text-xs text-gray-800 truncate mb-1" title="<%= file.original_name %>">
                <%= file.original_name %>
              </div>
              <div class="text-[11px] text-gray-400 mb-3 font-mono">
                <%= file.created_at ? file.created_at.split(' ')[0] : '' %>
              </div>

              <div class="mt-auto space-y-1.5">
                <button 
                  type="button" 
                  onclick="copyToClipboard('<%= file.url %>')" 
                  class="w-full py-1.5 bg-indigo-50 hover:bg-indigo-100 text-indigo-700 text-xs font-medium rounded-lg transition flex items-center justify-center gap-1"
                >
                  <span>📋</span> کپی آدرس فایل
                </button>

                <form action="/admin/media/delete/<%= file.id %>" method="POST" onsubmit="return confirm('آیا این فایل از دیسک و دیتابیس حذف شود؟');">
                  <button type="submit" class="w-full py-1 text-red-500 hover:text-red-700 hover:bg-red-50 text-[11px] rounded-lg transition">
                    حذف فایل
                  </button>
                </form>
              </div>
            </div>

          </div>
        <% }) %>
      </div>
    <% } %>
  </div>

</div>

<script>
  function copyToClipboard(url) {
    navigator.clipboard.writeText(url).then(() => {
      alert('آدرس مستقیم فایل کپی شد:\n' + url + '\n\nمی‌توانید آن را در تگ <img> در کدهای HTML پست‌ها قرار دهید!');
    });
  }
</script>

<%- include('../partials/footer') %>
